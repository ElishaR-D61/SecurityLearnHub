// The reference used is for if you need to assign a Sentinel severity score based an integer
// This could also be done with an if/else or a number of other ways

Table
| extend Column1asString  = tostring(Column1withInt) 
| parse Column1asString with Column1wholeNumber ".0" null // Used to remove a trailing decimal point
| extend Column1SentinelSeverity=replace_regex(Column1wholeNumber, @'([0-49]+(\d+))', @"Low") // replaces '0-49' with "Low"
| extend Column1SentinelSeverity=replace_regex(Column1SentinelSeverity, @'([50-75]+(\d+))', @"Medium") //goes through the same column and assigns '50-75' with "Medium"
| extend Column1SentinelSeverity=replace_regex(Column1SentinelSeverity, @'([76-99]+(\d+))', @"High") //goes through the same column and assigns '76-99' with "High"
| project-reorder Column1SentinelSeverity
